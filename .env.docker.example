# Django — DigitalOcean Droplet (не комітити як .env)
DJANGO_SETTINGS_MODULE=config.settings.docker
SECRET_KEY=change-me-in-production
DEBUG=False

SITE_DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com
USE_HTTPS=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
HTTP_PORT=80

ALLOWED_HOSTS=example.com,www.example.com,DROPLET_IP,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://example.com,http://www.example.com

POSTGRES_DB=didenko
POSTGRES_USER=didenko
POSTGRES_PASSWORD=strong-password
DATABASE_URL=postgres://didenko:strong-password@db:5432/didenko

# Після certbot:
# USE_HTTPS=true
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# ALLOWED_HOSTS=example.com,www.example.com,DROPLET_IP,127.0.0.1,localhost,web

ADMIN_NOTIFY_EMAIL=admin@example.com
DEFAULT_FROM_EMAIL=Didenko <noreply@example.com>
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CRM_WEBHOOK_URL=
CRM_API_KEY=

GTM_CONTAINER_ID=GTM-WVJDC8DM
GOOGLE_TAG_ID=AW-18394859385
GA4_MEASUREMENT_ID=

EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
